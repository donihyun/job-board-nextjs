# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
WEBHOOK_SECRET=

# Database
MONGODB_URL=

# Job Board APIs
CAREERJET_API_KEY=
CAREERJET_SITE_URL=
CAREERJET_PROXY_URL=
CAREERJET_PROXY_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# OpenAI
OPENAI_API_KEY=

# Google AdSense (Optional)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_VISACHART_SLOT=
NEXT_PUBLIC_ADSENSE_VISA_FINDER_SLOT=
NEXT_PUBLIC_ADSENSE_VISA_GUIDE_SLOT=
NEXT_PUBLIC_ADSENSE_COUNTRY_SLOT=
NEXT_PUBLIC_ADSENSE_VISA_DETAIL_TOP_SLOT=
