# Visa Monitor (Optional)
VISA_MONITOR_EXTRACTOR_MODEL=gpt-5.6-luna
VISA_MONITOR_VERIFIER_MODEL=gpt-5.6-terra

# Server Actions Configuration (for GitHub Codespaces or custom domains)
# Comma-separated list of allowed forwarded hosts
ALLOWED_FORWARDED_HOSTS=localhost,your-codespace-url.app.github.dev
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=localhost:3000,https://your-codespace-url.app.github.dev

# Environment
NODE_ENV=development
